{
  "name": "afila",
  "version": "0.0.0",
  "private": true,
  "description": "A local desktop app for daily programming challenges.",
  "license": "MIT",
  "packageManager": "pnpm@11.18.0",
  "engines": {
    "node": ">=24.18.0 <25.0.0"
  },
  "scripts": {
    "dev": "pnpm --filter './apps/desktop' dev",
    "format": "pnpm --filter './apps/desktop' format",
    "lint": "pnpm --filter './apps/desktop' lint",
    "test": "pnpm --filter './apps/desktop' test",
    "typecheck": "pnpm --filter './apps/desktop' typecheck",
    "build": "pnpm --filter './apps/desktop' build",
    "build:unpack": "pnpm --filter './apps/desktop' build:unpack",
    "verify:electron": "pnpm --filter './apps/desktop' exec node -p \"require('electron')\""
  }
}
